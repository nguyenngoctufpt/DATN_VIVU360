{
  "name": "DATN_VIVU360",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "concurrently --names \"API,TRAVEL-API,WEB,EXPO\" -c \"blue,cyan,magenta,yellow\" \"npm --prefix vivu360-api run dev\" \"npm --prefix vietnam-travel/api run dev\" \"npm --prefix vietnam-travel/public run dev\" \"npx expo start --go\"",
    "start:expo": "npx expo start --go",
    "start:online": "expo start",
    "start:offline": "expo start --offline",
    "start:clear": "expo start -c",
    "start:lan": "expo start --lan",
    "start:tunnel": "npx expo start --tunnel --go",
    "start:android": "concurrently --names \"API,TRAVEL-API,WEB,EXPO\" -c \"blue,cyan,magenta,yellow\" \"npm --prefix vivu360-api run dev\" \"npm --prefix vietnam-travel/api run dev\" \"npm --prefix vietnam-travel/public run dev\" \"npx expo start --android --go\"",
    "android": "npx expo start --android",
    "ios": "expo run:ios",
    "dev:api": "npm --prefix vivu360-api run dev",
    "dev:travel-api": "npm --prefix vietnam-travel/api run dev",
    "dev:web": "npm --prefix vietnam-travel/public run dev",
    "dev:map": "concurrently --names \"TRAVEL-API,WEB\" -c \"cyan,magenta\" \"npm --prefix vietnam-travel/api run dev\" \"npm --prefix vietnam-travel/public run dev\"",
    "dev": "npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-masked-view/masked-view": "0.3.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "@types/react": "~18.2.79",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "expo": "^51.0.0",
    "expo-constants": "~16.0.2",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-notifications": "~0.28.19",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "lucide-react-native": "^1.18.0",
    "mongodb": "^7.5.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-webview": "13.8.6",
    "socket.io": "^4.8.3"
  }
}
